<?xml version="1.0" encoding="utf-8"?>
<!--
  用户的健康相关内容不进备份。

  iOS 那边靠 `TenantPaths.excludeFromBackup` 把整个数据目录标出去;Android 的对等做法是
  `allowBackup="false"` 加这份规则。理由一样:会话文件里可能记着用户口述的测量,附件里是带姓名和
  就诊号的化验单,而云备份多数人是开着的。

  代价是**换新手机时这些数据不跟着走**——隐私说明里要照实写这一条,盘上的行为和那份文件
  必须逐字对上(iOS 那边有测试盯着,这边也该有)。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
