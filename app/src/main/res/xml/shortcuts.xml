<?xml version="1.0" encoding="utf-8"?>
<!--
  App Shortcuts / Assistant 能力入口。Android 当前不读取设备健康数据，只保留「问 Vana」。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask_vana"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_ask_short"
        android:shortcutLongLabel="@string/shortcut_ask_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pinapia.vana"
            android:targetClass="com.pinapia.vana.MainActivity"
            android:data="vana://action/ask" />
    </shortcut>

    <!-- Google Assistant App Actions: GET_THING → 问 Vana -->
    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pinapia.vana"
            android:targetClass="com.pinapia.vana.MainActivity">
            <url-template android:value="vana://action/ask?q={name}" />
            <parameter
                android:name="name"
                android:key="q"
                android:mimeType="text/*" />
        </intent>
    </capability>
</shortcuts>
