      "tool_call": false,
      "structured_output": false,
      "modalities": { "input": ["audio"], "output": ["text"] },
      "limit": { "context": 8192, "output": 8192 },
      "modalityCapabilities": ["speech.transcribe"]
    },
    {
      "id": "stepaudio-2.5-realtime",
      "display_name": "StepAudio 2.5 Realtime",
