      "limit": { "context": 8192, "output": 8192 },
      "modalityCapabilities": ["realtime.voice"]
    },
    {
      "id": "step-image-edit-2",
      "display_name": "Step Image Edit 2",
      "description": "Low-latency model for text-to-image generation and image editing",
      "type": "image-generation",
      "tool_call": false,
      "structured_output": false,
      "modalities": { "input": ["text", "image"], "output": ["image"] },
      "limit": { "context": 512, "output": 1 },
      "modalityCapabilities": ["image.generate", "image.edit"]
    },
    {
      "id": "step-3.5-flash-2603",
