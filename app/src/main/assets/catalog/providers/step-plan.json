      "structured_output": false,
      "modalities": { "input": ["text"], "output": ["audio"] },
      "limit": { "context": 1000, "output": 8192 },
      "modalityCapabilities": ["speech.synthesize"]
    },
    {
      "id": "stepaudio-2.5-asr",
      "display_name": "StepAudio 2.5 ASR",
