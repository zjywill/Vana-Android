      "extra_capabilities": {
        "reasoning": {
          "supported": true,
          "interleaved": true,
          "summaries": true,
          "visibility": "summary",
          "continuation": ["thinking_blocks"]
        }
      }
    },
    {
      "id": "step-3.5-flash",
