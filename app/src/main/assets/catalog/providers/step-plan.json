{
  "id": "step-plan",
  "name": "Step Plan",
  "api": "https://api.stepfun.com/step_plan/v1",
  "adapter": "openai",
  "models": [
    {
      "id": "step-3.7-flash",
      "display_name": "Step 3.7 Flash",
      "description": "Flagship multimodal reasoning model with native image and video input",
      "type": "chat",
      "attachment": true,
      "reasoning": { "supported": true, "default": true },
      "reasoning_options": [{ "type": "effort", "values": ["low", "medium", "high"] }],
      "tool_call": true,
      "interleaved": { "field": "reasoning_content" },
      "modalities": { "input": ["text", "image", "video"], "output": ["text"] },
      "limit": { "context": 256000, "input": 256000, "output": 256000 },
      "extra_capabilities": {
        "reasoning": {
          "supported": true,
          "interleaved": true,
          "summaries": true,
          "visibility": "summary",
          "continuation": ["thinking_blocks"]
        }
      }
    },
    {
      "id": "step-router-v1",
      "display_name": "Step Router V1",
      "description": "Intelligent router between DeepSeek V4 Pro and Step 3.7 Flash",
      "type": "chat",
      "reasoning": { "supported": true, "default": true },
      "tool_call": true,
      "modalities": { "input": ["text"], "output": ["text"] },
      "limit": { "context": 1000000, "output": 384000 }
    },
    {
      "id": "stepaudio-2.5-chat",
      "display_name": "StepAudio 2.5 Chat",
      "description": "Text conversation model with text-only output in the Step Plan channel",
      "type": "chat",
      "reasoning": { "supported": false },
      "tool_call": true,
      "modalities": { "input": ["text"], "output": ["text"] },
      "limit": { "context": 128000, "output": 16384 },
      "modalityCapabilities": []
    },
    {
      "id": "stepaudio-2.5-tts",
